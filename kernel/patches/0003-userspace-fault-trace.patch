diff --git a/include/linux/shadow_msm_trace.h b/include/linux/shadow_msm_trace.h
new file mode 100644
index 0000000..af59e7d
--- /dev/null
+++ b/include/linux/shadow_msm_trace.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_SHADOW_MSM_TRACE_H
+#define _LINUX_SHADOW_MSM_TRACE_H
+
+#ifdef CONFIG_SHADOW_MSM_EARLY_TRACE
+static inline void shadow_msm_diag_trace(const char *message)
+{
+	((void (*)(const char *))0x00816cf4UL)(message);
+}
+
+static inline void shadow_msm_diag_hex(const char *prefix,
+				       unsigned long value)
+{
+	static const char digits[] = "0123456789ABCDEF";
+	char message[64];
+	unsigned int digit;
+	unsigned int length = 0;
+
+	while (*prefix && length < sizeof(message) - 13)
+		message[length++] = *prefix++;
+	message[length++] = '0';
+	message[length++] = 'x';
+	for (digit = 0; digit < 8; digit++)
+		message[length++] =
+			digits[(value >> ((7 - digit) * 4)) & 0xf];
+	message[length++] = '\r';
+	message[length++] = '\n';
+	message[length] = '\0';
+	shadow_msm_diag_trace(message);
+}
+#else
+static inline void shadow_msm_diag_trace(const char *message)
+{
+}
+
+static inline void shadow_msm_diag_hex(const char *prefix,
+				       unsigned long value)
+{
+}
+#endif
+
+#endif
diff --git a/kernel/exit.c b/kernel/exit.c
