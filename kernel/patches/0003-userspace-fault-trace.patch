+#include <linux/shadow_msm_trace.h>
 
 #include <linux/uaccess.h>
 #include <asm/unistd.h>
@@ -760,6 +761,13 @@ void __noreturn do_exit(long code)
 	struct task_struct *tsk = current;
 	int group_dead;
 
+	if (unlikely(is_global_init(tsk))) {
+		shadow_msm_diag_trace(
+			"Shadow-MSM: PID 1 entered do_exit\r\n");
+		shadow_msm_diag_hex("Shadow-MSM: PID 1 exit code ",
+				    (unsigned long)code);
+	}
+
 	synchronize_group_exit(tsk, code);
 
 	WARN_ON(tsk->plug);
