+static __always_inline void shadow_msm_c_trace_hex(const char *prefix,
+						    unsigned long value)
+{
+	static const char digits[] = "0123456789ABCDEF";
+	char message[64];
+	unsigned int digit;
+	unsigned int length = 0;
+
+	while (*prefix && length < sizeof(message) - 13)
+		message[length++] = *prefix++;
+
+	message[length++] = '0';
+	message[length++] = 'x';
+	for (digit = 0; digit < 8; digit++)
+		message[length++] = digits[(value >> ((7 - digit) * 4)) & 0xf];
+	message[length++] = '\r';
+	message[length++] = '\n';
+	message[length] = '\0';
+	shadow_msm_c_trace(message);
+}
+
